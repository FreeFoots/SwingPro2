# Copy to .env and supply your own local values. Never commit .env.
APP_NAME=SwingPro2
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=swingpro2
PG_PASSWORD=replace-with-a-local-database-password
PG_DB=swingpro2
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TIMEZONE=Asia/Shanghai
CELERY_TASK_ALWAYS_EAGER=false
VIDEO_ROOT=storage/videos
THUMB_ROOT=storage/thumbs
VIDEO_TMP_ROOT=storage/download_temp
DRAW_JSON_ROOT=storage/drawings
LOG_DIR=logs
LOG_LEVEL=INFO
CORS_ORIGINS=[]
WEB_PLATFORM_URL=http://127.0.0.1:8000/platform.html
# Development only: local prints OTPs to the terminal; no real SMS is sent.
SMS_PROVIDER=local
OTP_TTL_SECONDS=300
OTP_SEND_COOLDOWN_SECONDS=60
OTP_DAILY_LIMIT=10
FIELD_BIND_CODE_EXPIRES_SECONDS=300
FIELD_BIND_DURATION_SECONDS=3600
SMS_SPUG_URL=
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
# Optional WeChat integrations; use your own application credentials.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_WEB_ID=
WECHAT_WEB_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_STATE_PREFIX=
